# Образец настроек сервера. Скопируйте в .env и заполните.
# Файл .env в репозиторий не попадает.

# Длинный случайный ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=task-manager.example.ru,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://task-manager.example.ru

# База данных: SQLite на томе Docker ...
SQLITE_PATH=/app/data/db.sqlite3
# ... либо PostgreSQL, если задан DATABASE_URL (тогда SQLITE_PATH не используется).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Администратор создаётся при запуске, если заданы обе переменные.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
DJANGO_SUPERUSER_EMAIL=

# Демонстрационные данные для проверки.
DEMO_DATA=False
DEMO_PASSWORD=

# Публикация порта контейнера наружу.
APP_BIND_IP=127.0.0.1
APP_PORT=8000
